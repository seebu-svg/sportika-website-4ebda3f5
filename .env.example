# Supabase — shared backend with the Flutter app.
# Copy to .env.local and fill in your project values. The app runs on bundled
# seed content until these are set, then reads from Supabase automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for SEO metadata, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
